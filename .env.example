NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
RATE_LIMIT_HMAC_SECRET=

# Use an isolated Supabase project. Never point these values at production unless explicitly approved.
SECURITY_TEST_SUPABASE_URL=
SECURITY_TEST_ANON_KEY=
SECURITY_TEST_MODE=anon-only
SECURITY_TEST_TIMEOUT_MS=10000
SECURITY_TEST_USER_A_JWT=
SECURITY_TEST_USER_B_JWT=
SECURITY_TEST_USER_A_EVENT_ID=
SECURITY_TEST_USER_B_EVENT_ID=

# Performance tools are default-deny and never reuse the app's Supabase credentials.
# Use only a local or disposable verification target. Set PERF_COMMAND=cleanup explicitly to remove one run.
PERF_SUPABASE_URL=
PERF_EXPECTED_PROJECT_REF=
PERF_PRODUCTION_SUPABASE_URL=
PERF_SUPABASE_ANON_KEY=
PERF_SUPABASE_SERVICE_ROLE_KEY=
PERF_RUN_ID=
PERF_COMMAND=seed
PERF_OWNER_USER_ID=
PERF_TEST_USER_JWT=
PERF_EVENT_ID=
PERF_MONTH=2026-01-01

# Lighthouse uses an already authenticated, dedicated Chrome test profile.
PERF_APP_URL=http://localhost:3000
PERF_EXPECTED_APP_HOST=
PERF_PRODUCTION_APP_URL=
PERF_CHROME_USER_DATA_DIR=
PERF_CHROME_PROFILE_DIRECTORY=
